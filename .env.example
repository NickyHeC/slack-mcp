# =============================================================================
# Slack MCP Server — Environment Variables (OAuth)
# =============================================================================
# Copy this file:  cp .env.example .env
# Then fill in the values below.

# =============================================================================
# Dedalus Platform
# =============================================================================

DEDALUS_AS_URL=https://as.dedaluslabs.ai
DEDALUS_API_KEY=
DEDALUS_API_URL=https://api.dedaluslabs.ai

# =============================================================================
# Slack Access Token (for local testing only)
# =============================================================================
# Obtain a token from your Slack app's OAuth & Permissions page or via the
# OAuth flow. When deployed on Dedalus, DAuth handles the flow automatically.
# Must match SecretKeys(token="SLACK_ACCESS_TOKEN") in src/main.py.

SLACK_ACCESS_TOKEN=

# =============================================================================
# OAuth Configuration
# =============================================================================
# These variables are consumed by the Dedalus platform to handle the OAuth
# token exchange. They must be baked into the server at deploy time.

OAUTH_ENABLED=true
OAUTH_AUTHORIZE_URL=https://slack.com/oauth/v2/authorize
OAUTH_TOKEN_URL=https://slack.com/api/oauth.v2.access
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPES_AVAILABLE=channels:read,channels:history,groups:read,groups:history,mpim:history,im:history,chat:write,chat:write.public,users:read,users:read.email,users.profile:read,search:read,canvases:read,canvases:write
OAUTH_BASE_URL=https://slack.com/api
